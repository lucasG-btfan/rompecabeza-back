# ============================================================
# Rompecabezas — Backend (Render)
# ============================================================
# Copiá este archivo a `.env` para desarrollo local, o seteá las
# mismas variables en Render Dashboard (Settings → Environment).
# REGLA DURA: acá solo viven NOMBRES y propósito — nunca valores reales.
#
# En Render solo hace falta setear: DATABASE_URL, SECRET_KEY,
# COOKIE_SECURE, COOKIE_SAMESITE, ALLOWED_ORIGINS y DEBUG.

# Conexión a PostgreSQL.
# En Render usá la "Internal Database URL" del servicio PostgreSQL
# (ya viene con credenciales y sslmode=require). Para conexión externa
# fuera de Render agregá ?sslmode=require al final de la URL.
DATABASE_URL=

# Clave para firmar las cookies de sesión (itsdangerous).
# OBLIGATORIA en producción — el default del código es inseguro.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Flag "Secure" de la cookie: false en dev (http://localhost),
# true en producción (Render sirve HTTPS).
COOKIE_SECURE=false

# Flag "SameSite" de la cookie: "lax" en dev (mismo sitio localhost),
# "none" en producción (frontend en *.vercel.app y backend en
# *.onrender.com son cross-site → SameSite=None es lo único que viaja
# en fetch desde JS; REQUIERE COOKIE_SECURE=true).
COOKIE_SAMESITE=lax

# Orígenes permitidos para CORS, en FORMATO JSON (lista de strings).
# En Render setealo con comillas simples exactas, ej:
#   ALLOWED_ORIGINS='["https://tu-app.vercel.app"]'
# El backend también acepta CORS_ORIGINS como alias (nombre histórico
# del campo) — el .env local existente no se rompe.
ALLOWED_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Echo de SQL en consola: true en dev, false en producción.
DEBUG=true